# cp .env.example .env  — o .env fica fora do git e do pacote do cf push (.cfignore). Nunca imprima o conteúdo.

# Datadog: Organization Settings → API Keys (o valor da key, não o Key ID).
DD_API_KEY=<api-key-do-datadog>
# Site = host da barra do navegador sem o "app.": us5.datadoghq.com, datadoghq.com (US1), us3.datadoghq.com,
# datadoghq.eu, ap1.datadoghq.com.
DD_SITE=us5.datadoghq.com
# Tag env dos logs no Datadog.
DD_ENV=trial

# Opcional, só para conferir pela API que os logs chegaram (scripts/check-datadog.sh):
# Organization Settings → Application Keys, com o escopo logs_read_data.
DD_APP_KEY=
